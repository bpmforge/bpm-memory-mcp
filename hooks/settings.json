{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/hooks-settings.json",
  "description": "Claude Memory plugin hook configurations - V4 with automation",
  "hooks": {
    "PreToolUse": [
      {
        "description": "Restore session on conversation start",
        "matcher": "SessionStart",
        "command": "./hooks/session-restore.sh",
        "timeout": 5000
      }
    ],
    "PostToolUse": [
      {
        "description": "Track errors for memory storage",
        "matcher": "Bash|Write|Edit",
        "command": "./hooks/error-tracker.sh \"$TOOL_RESULT\"",
        "timeout": 2000,
        "onError": "continue"
      },
      {
        "description": "Suggest memory extraction after significant operations",
        "matcher": "Write|Edit|Bash",
        "command": "./hooks/memory-extract.sh \"$TOOL_NAME\" \"$TOOL_RESULT\"",
        "timeout": 2000,
        "onError": "continue"
      },
      {
        "description": "Check goal alignment after code changes",
        "matcher": "Write|Edit",
        "command": "./hooks/goal-check.sh",
        "timeout": 1000,
        "onError": "continue"
      }
    ],
    "SessionEnd": [
      {
        "description": "Auto-save session on conversation end",
        "command": "./hooks/session-save.sh",
        "timeout": 5000
      }
    ]
  }
}
