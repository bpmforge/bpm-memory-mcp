{
  "description": "50+ evasion attempts - bypass techniques that may or may not be caught",
  "note": "Some of these WILL bypass detection - the goal is to document what works and what doesn't",
  "testCases": [
    {
      "category": "encoding_tricks",
      "samples": [
        { "content": "cGFzc3dvcmQ9InNlY3JldDEyMyI=", "description": "Base64 encoded password=\"secret123\"", "expectedBlocked": false },
        { "content": "password%3D%22secret123%22", "description": "URL encoded password=\"secret123\"", "expectedBlocked": false },
        { "content": "\\u0070\\u0061\\u0073\\u0073\\u0077\\u006f\\u0072\\u0064=\"secret\"", "description": "Unicode escaped keyword", "expectedBlocked": true },
        { "content": "pas\\x73word=\"secret123\"", "description": "Hex escape in keyword", "expectedBlocked": false },
        { "content": "api_key=YWJjMTIzZGVmNDU2", "description": "Unquoted base64 value", "expectedBlocked": false },
        { "content": "token = atob('c2VjcmV0X3Rva2VuXzEyMw==')", "description": "Runtime decoded value", "expectedBlocked": false },
        { "content": "secret: !!binary c2VjcmV0dmFsdWU=", "description": "YAML binary tag", "expectedBlocked": false },
        { "content": "&#112;&#97;&#115;&#115;&#119;&#111;&#114;&#100;=\"secret\"", "description": "HTML entity encoded", "expectedBlocked": false },
        { "content": "p\\u0061ssword=\"secret123\"", "description": "Partial unicode escape", "expectedBlocked": false },
        { "content": "const secret = Buffer.from('c2VjcmV0', 'base64').toString()", "description": "Buffer decode", "expectedBlocked": false },
        { "content": "api_key = '%73%65%63%72%65%74'", "description": "URL encoded value", "expectedBlocked": false },
        { "content": "tok\\x65n=\"mysecrettoken\"", "description": "Hex in token keyword", "expectedBlocked": false },
        { "content": "eval(atob('cGFzc3dvcmQ9InNlY3JldCI='))", "description": "Eval with base64", "expectedBlocked": false },
        { "content": "JSON.parse('{\"password\":\"secret\"}')", "description": "JSON string parse", "expectedBlocked": true },
        { "content": "ROT13: cnffjbeq=\"frperg\"", "description": "ROT13 encoded", "expectedBlocked": false }
      ]
    },
    {
      "category": "string_splitting",
      "samples": [
        { "content": "const p = 'pass' + 'word' + '=' + '\"secret\"'", "description": "Concatenated keyword", "expectedBlocked": false },
        { "content": "['pass','word','=',quote,'secret',quote].join('')", "description": "Array join", "expectedBlocked": false },
        { "content": "const key = 'api_' + 'key'; config[key] = 'secret'", "description": "Dynamic property", "expectedBlocked": false },
        { "content": "secret_\nkey=\"value\"", "description": "Newline in keyword", "expectedBlocked": false },
        { "content": "api_/*comment*/key=\"secret\"", "description": "Comment in keyword", "expectedBlocked": false },
        { "content": "`pass${'word'}=\"secret\"`", "description": "Template literal split", "expectedBlocked": false },
        { "content": "const x = 'pass'; const y = 'word'; const z = x+y+'=\"sec\"'", "description": "Multi-var concat", "expectedBlocked": false },
        { "content": "password\\u003d\"secret\"", "description": "Unicode equals sign", "expectedBlocked": false },
        { "content": "String.fromCharCode(112,97,115,115,119,111,114,100)", "description": "fromCharCode keyword", "expectedBlocked": false },
        { "content": "config['api' + '_' + 'key'] = secret", "description": "Bracket notation split", "expectedBlocked": false }
      ]
    },
    {
      "category": "unusual_formats",
      "samples": [
        { "content": "password: |\n  mysecret\n  value123", "description": "YAML multiline literal", "expectedBlocked": false },
        { "content": "password: >\n  mysecret\n  value", "description": "YAML folded scalar", "expectedBlocked": false },
        { "content": "{\n  \"nested\": {\n    \"deep\": {\n      \"password\": \"secret\"\n    }\n  }\n}", "description": "Deeply nested JSON", "expectedBlocked": true },
        { "content": "[defaults]\npassword = secret123", "description": "INI format", "expectedBlocked": true },
        { "content": "export PASSWORD=$'secret\\x00value'", "description": "Null byte in value", "expectedBlocked": true },
        { "content": "password=\"secret\"; /* not a real secret */", "description": "Comment after value", "expectedBlocked": true },
        { "content": "PASSWORD=secret #notreal", "description": "Shell comment", "expectedBlocked": true },
        { "content": "set PASSWORD=secret123", "description": "Windows SET command", "expectedBlocked": true },
        { "content": "$env:API_KEY = 'secret'", "description": "PowerShell env", "expectedBlocked": true },
        { "content": "<password>secret123</password>", "description": "XML element", "expectedBlocked": true },
        { "content": "password := \"secret123\"", "description": "Go-style assignment", "expectedBlocked": true },
        { "content": "let password: String = \"secret\"", "description": "Rust/Swift typed", "expectedBlocked": true },
        { "content": "@password = \"secret123\"", "description": "Ruby instance var", "expectedBlocked": true },
        { "content": "self.password = 'secret123'", "description": "Python self", "expectedBlocked": true },
        { "content": "this->password = \"secret\"", "description": "PHP/C++ arrow", "expectedBlocked": true }
      ]
    },
    {
      "category": "edge_cases",
      "samples": [
        { "content": "password=\"" + "A".repeat(10000) + "\"", "description": "Very long value (10K chars)", "expectedBlocked": true },
        { "content": "password=\"\\\"nested\\\"quotes\\\"\"", "description": "Nested escaped quotes", "expectedBlocked": true },
        { "content": "password = ''", "description": "Empty string value", "expectedBlocked": false },
        { "content": "password=\"\"", "description": "Empty quoted value", "expectedBlocked": false },
        { "content": "password='\\n\\t\\r'", "description": "Only whitespace escapes", "expectedBlocked": true },
        { "content": "password = \"    \"", "description": "Only spaces", "expectedBlocked": true },
        { "content": "PASSWORD=\"SECRET\" password=\"secret\"", "description": "Duplicate on same line", "expectedBlocked": true },
        { "content": "\u200Bpassword=\"secret\"", "description": "Zero-width space prefix", "expectedBlocked": true },
        { "content": "pass\u00ADword=\"secret\"", "description": "Soft hyphen in keyword", "expectedBlocked": false },
        { "content": "ⓟⓐⓢⓢⓦⓞⓡⓓ=\"secret\"", "description": "Circled letters", "expectedBlocked": false },
        { "content": "ＰＡＳＳＷＯＲＤ=\"secret\"", "description": "Fullwidth chars", "expectedBlocked": false },
        { "content": "password\t\t=\t\t\"secret\"", "description": "Tab separated", "expectedBlocked": true },
        { "content": "password   =   \"secret\"", "description": "Multi-space separated", "expectedBlocked": true },
        { "content": "/*password=\"notreal\"*/password=\"secret\"", "description": "Comment then real", "expectedBlocked": true },
        { "content": "//password=\"fake\"\npassword=\"real\"", "description": "Comment line then real", "expectedBlocked": true }
      ]
    }
  ]
}
